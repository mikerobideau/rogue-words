[gd_resource type="Resource" script_class="HoldingsTutorialStep" load_steps=2 format=3]

[ext_resource type="Script" path="res://prototypes/holdings/types/holdings_tutorial_step.gd" id="1_tut"]

[resource]
script = ExtResource("1_tut")
title = "Put it to work"
body = "Businesses pay out when you operate them with a die. The die box on each card shows which rolls it accepts. {card:lemonade_stand} takes any die.\nClick the 5, then click your {card:lemonade_stand}."
targets = PackedStringArray("die:0", "board:4")
wait = "operated"
